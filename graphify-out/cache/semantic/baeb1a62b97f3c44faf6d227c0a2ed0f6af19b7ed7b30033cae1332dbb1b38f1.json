{"nodes": [{"id": "_agents_skills_apple_design_skill_apple_design", "label": "Apple Design", "file_type": "document", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_apple_design_skill_fluid_interface", "label": "Fluid Interface", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An interface feels alive when motion starts from the current on-screen value, inherits the user's velocity, projects momentum forward, and can be grabbed and reversed at any instant. Springs make this natural because they are interruptible and velocity-aware."}, {"id": "_agents_skills_apple_design_skill_four_human_needs", "label": "Four Human Needs", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apple frames design as serving safety and predictability, understanding, achievement, and joy. Every motion rule serves one of them."}, {"id": "_agents_skills_apple_design_skill_response_latency", "label": "Response Latency", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Respond on pointer-down, not on release, and keep feedback continuous during the gesture. The moment lag appears, the feeling of directness falls off a cliff."}, {"id": "_agents_skills_apple_design_skill_direct_manipulation", "label": "Direct Manipulation", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Touch and content should move together. Track 1:1 with Pointer Events and setPointerCapture, and respect the grab offset instead of snapping to the element center."}, {"id": "_agents_skills_apple_design_skill_interruptibility", "label": "Interruptibility", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every animation must be redirectable at any moment from the live presentation value, never the logical target. CSS transitions and keyframes cannot be grabbed and reversed mid-flight, so gesture-driven motion should use springs. On reversal, blend velocity instead of hard-cutting it."}, {"id": "_agents_skills_apple_design_skill_springs", "label": "Springs Over Scripted Animation", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed-duration animation cannot respond to new input; a spring can, because new input only changes the target. Apple replaced mass, stiffness, and damping with damping ratio and response. Default damping is 1.0; damping near 0.8 is reserved for gestures that already carried momentum."}, {"id": "_agents_skills_apple_design_skill_damping_ratio", "label": "Damping Ratio", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controls overshoot. 1.0 is critically damped with no bounce. Below 1.0 overshoots and oscillates; lower is bouncier."}, {"id": "_agents_skills_apple_design_skill_spring_response", "label": "Spring Response", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How quickly the value reaches the target, in seconds. This is not duration: a spring has no fixed duration, and its settle time emerges from the parameters."}, {"id": "_agents_skills_apple_design_skill_velocity_handoff", "label": "Velocity Handoff", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a gesture ends, the animation must continue at the finger's exact velocity so there is no visible seam. Some spring APIs want relative velocity: gestureVelocity divided by remaining distance."}, {"id": "_agents_skills_apple_design_skill_momentum_projection", "label": "Momentum Projection", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not snap from the release point. Project the resting position with exponential decay, (v/1000)*decelerationRate/(1-decelerationRate), then snap to the target nearest that projection. Apple does not ship the textbook v-squared over 2a form."}, {"id": "_agents_skills_apple_design_skill_spatial_consistency", "label": "Spatial Consistency", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If something disappears one way, it should emerge from where it came. Enter and exit along the same path, anchor popovers to their trigger with transform-origin, and mirror easing on reversible transitions."}, {"id": "_agents_skills_apple_design_skill_rubber_banding", "label": "Rubber-banding", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At an edge, resist progressively instead of stopping hard. A hard stop reads as frozen; continuous resistance reads as responsive."}, {"id": "_agents_skills_apple_design_skill_gesture_feel", "label": "Gesture Feel Checklist", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highlight on touch-down and commit on touch-up. Require about 10px of hysteresis before locking a drag direction, recognize plausible gestures in parallel, and avoid recognizers that only report a final state."}, {"id": "_agents_skills_apple_design_skill_frame_smoothness", "label": "Frame-Level Smoothness", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smoothness is about what is in the frames, not only the frame rate. Animate compositor-friendly transform and opacity, hint with will-change, and use requestAnimationFrame as the web equivalent of CADisplayLink."}, {"id": "_agents_skills_apple_design_skill_materials_and_depth", "label": "Materials and Depth", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translucent materials convey hierarchy. On the web, approximate them with backdrop-filter. Never stack a light translucent surface on another, and materialize glass by animating blur with scale rather than fading opacity alone."}, {"id": "_agents_skills_apple_design_skill_multimodal_feedback", "label": "Multimodal Feedback", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion, sound, and haptics must be causal, harmonious on the same frame, and useful. Reserve haptics and sound for meaningful moments so over-feedback does not train people to ignore it."}, {"id": "_agents_skills_apple_design_skill_reduced_motion_accessibility", "label": "Reduced Motion and Accessibility", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduced motion means a gentler, non-vestibular equivalent, not zero feedback. Replace slides, springs, and parallax with short opacity cross-fades, and also honor prefers-reduced-transparency and prefers-contrast as independent signals."}, {"id": "_agents_skills_apple_design_skill_optical_typography", "label": "Optical Typography", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tracking and leading are size-specific. Large display text wants negative letter-spacing and tight leading; small text wants slightly positive tracking. Build hierarchy from weight, size, and leading together, and scale layout with the user's text size."}, {"id": "_agents_skills_apple_design_skill_eight_design_principles", "label": "Eight Design Principles", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Purpose, agency, responsibility, familiarity, flexibility, simplicity, craft, and delight. Delight is the result of the other seven, not decoration added on top."}, {"id": "_agents_skills_apple_design_skill_purpose", "label": "Purpose", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make with intention and decide what not to build. Every feature spends the user's time, attention, and trust."}, {"id": "_agents_skills_apple_design_skill_agency", "label": "Agency", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep people in control and back it with forgiveness. Confirm only genuinely destructive, irreversible actions."}, {"id": "_agents_skills_apple_design_skill_responsibility", "label": "Responsibility", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Act in the user's interest: ask for privacy at the right moment, and anticipate misuse and harm, especially with AI."}, {"id": "_agents_skills_apple_design_skill_familiarity", "label": "Familiarity", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build on metaphors people already know and keep behavior consistent with appearance. Break a familiar pattern only when it is proven better."}, {"id": "_agents_skills_apple_design_skill_flexibility", "label": "Flexibility", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapt to context, device, and the full range of abilities. When no single layout fits, let people personalize."}, {"id": "_agents_skills_apple_design_skill_simplicity", "label": "Simplicity", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strip the unnecessary so the core purpose shines. Simplicity is not minimalism: burying everything in one place looks minimal but is not simple."}, {"id": "_agents_skills_apple_design_skill_craft", "label": "Craft", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uncompromising, defensible detail builds trust. Jittery scroll, misaligned icons, and layouts that break on rotation read as carelessness."}, {"id": "_agents_skills_apple_design_skill_delight", "label": "Delight", "file_type": "rationale", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delight is the result of getting the other seven principles right, not confetti tacked on top. Decide the emotion and reinforce it in every decision."}, {"id": "_agents_skills_apple_design_skill_additive_animations", "label": "Additive Animations", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iOS carries velocity through a re-target so a reversal does not create a velocity discontinuity. On the web, choose a spring library that re-targets from the current velocity."}, {"id": "_agents_skills_apple_design_skill_pointer_capture", "label": "Pointer Capture", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setPointerCapture keeps tracking even when the pointer leaves the element's bounds."}, {"id": "_agents_skills_apple_design_skill_designing_fluid_interfaces", "label": "Designing Fluid Interfaces", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WWDC 2018 talk that is the chief source for this fluid-motion model, including the momentum projection sample."}, {"id": "_agents_skills_apple_design_skill_designing_audio_haptic_experiences", "label": "Designing Audio-Haptic Experiences", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source for the causality, harmony, and utility rules of combining motion, sound, and haptics."}, {"id": "_agents_skills_apple_design_skill_details_of_ui_typography", "label": "The Details of UI Typography", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WWDC 2020 talk on optical sizing, tracking, and leading."}, {"id": "_agents_skills_apple_design_skill_principles_of_great_design", "label": "Principles of Great Design", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WWDC 2026 source for the eight design principles."}, {"id": "_agents_skills_apple_design_skill_motion_library", "label": "Motion / Framer Motion", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web spring libraries Apple's damping and response map onto. The bounce and duration spring API is the house-style mapping."}, {"id": "_agents_skills_apple_design_skill_vaul", "label": "Vaul", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as a bottom-sheet that uses Apple-style momentum projection."}, {"id": "_agents_skills_apple_design_skill_embla", "label": "Embla", "file_type": "concept", "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as a carousel that uses Apple-style momentum projection."}], "edges": [{"source": "_agents_skills_apple_design_skill_apple_design", "target": "_agents_skills_apple_design_skill_fluid_interface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_apple_design_skill_apple_design", "target": "_agents_skills_apple_design_skill_designing_fluid_interfaces", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_apple_design_skill_fluid_interface", "target": "_agents_skills_apple_design_skill_four_human_needs", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_apple_design_skill_fluid_interface", "target": "_agents_skills_apple_design_skill_response_latency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_apple_design_skill_fluid_interface", "target": "_agents_skills_apple_design_skill_direct_manipulation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/apple-design/SKILL.md", "source_location": null, "weight": 1.