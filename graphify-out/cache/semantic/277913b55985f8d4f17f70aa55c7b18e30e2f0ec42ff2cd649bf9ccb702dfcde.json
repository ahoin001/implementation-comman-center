{"nodes": [{"id": "_agents_skills_emil_design_eng_skill_design_engineering", "label": "Design Engineering", "file_type": "document", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_emil_design_eng_skill_emil_kowalski", "label": "Emil Kowalski", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Author of the design-engineering philosophy encoded here and taught at animations.dev."}, {"id": "_agents_skills_emil_design_eng_skill_animations_dev", "label": "animations.dev", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emil Kowalski's course, cited as the deeper source for this philosophy."}, {"id": "_agents_skills_emil_design_eng_skill_paul_graham", "label": "Paul Graham", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_emil_design_eng_skill_taste_is_trained", "label": "Taste Is Trained", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Good taste is a trained instinct built by studying why the best interfaces feel the way they do, not a personal preference."}, {"id": "_agents_skills_emil_design_eng_skill_unseen_details_compound", "label": "Unseen Details Compound", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most details users never consciously notice. Their aggregate is what makes an interface feel right. Quoted from Paul Graham: unseen details sing in tune."}, {"id": "_agents_skills_emil_design_eng_skill_beauty_is_leverage", "label": "Beauty Is Leverage", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "People select tools on the overall experience. Good defaults and good animations are differentiators, and beauty is underused in software."}, {"id": "_agents_skills_emil_design_eng_skill_before_after_review_table", "label": "Before/After Review Table", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI reviews must be one markdown table with Before, After, and Why columns. A Before/After list is the wrong format."}, {"id": "_agents_skills_emil_design_eng_skill_animation_decision_framework", "label": "Animation Decision Framework", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before writing animation code, answer in order: should it animate, what is the purpose, what easing, and how fast."}, {"id": "_agents_skills_emil_design_eng_skill_frequency_gate", "label": "Frequency Gate", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never animate keyboard-initiated or 100-times-a-day actions; repetition makes motion feel slow and disconnected. Raycast ships no open/close animation for that reason. Tens per day should be reduced; occasional motion can be standard; rare moments can add delight."}, {"id": "_agents_skills_emil_design_eng_skill_animation_purpose", "label": "Animation Purpose", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every animation must answer why it exists. Valid purposes are spatial consistency, state indication, explanation, feedback, and preventing jarring changes. Looking cool is not a purpose for something seen often."}, {"id": "_agents_skills_emil_design_eng_skill_easing_decision", "label": "Easing Decision", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entering or exiting uses a strong ease-out. On-screen movement uses ease-in-out. Hover and color use ease. Constant motion uses linear. Never use ease-in for UI: it delays the moment the user is watching, so the same duration feels slower."}, {"id": "_agents_skills_emil_design_eng_skill_ui_duration_budget", "label": "UI Duration Budget", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI animations should stay under 300ms. Button feedback is 100-160ms, tooltips 125-200ms, dropdowns 150-250ms, modals and drawers 200-500ms. Faster motion feels more responsive even when the work takes the same time."}, {"id": "_agents_skills_emil_design_eng_skill_perceived_performance", "label": "Perceived Performance", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fast spinner, a 180ms select, and instant subsequent tooltips make the app feel faster at the same actual speed. Ease-out feels faster than ease-in at the same duration because movement starts immediately."}, {"id": "_agents_skills_emil_design_eng_skill_spring_animations", "label": "Spring Animations", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Springs have no fixed duration; they settle from physical parameters. Prefer Apple's duration-and-bounce API when reasoning about UI. Keep bounce in the 0.1-0.3 range and reserve it for drag-to-dismiss and playful motion. Springs keep velocity when interrupted, unlike keyframes."}, {"id": "_agents_skills_emil_design_eng_skill_press_feedback", "label": "Press Feedback", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Buttons and other pressable elements use transform scale 0.97 on :active, with a 160ms ease-out. The scale should stay between 0.95 and 0.98."}, {"id": "_agents_skills_emil_design_eng_skill_never_scale_zero", "label": "Never Scale From Zero", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing in the real world appears from nothing. Start entrances from scale 0.95 or higher combined with opacity 0."}, {"id": "_agents_skills_emil_design_eng_skill_origin_aware_popovers", "label": "Origin-Aware Popovers", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Popovers should scale from their trigger via the Radix or Base UI transform-origin variable. The default center origin is wrong for almost every popover."}, {"id": "_agents_skills_emil_design_eng_skill_modal_origin_exception", "label": "Modal Origin Exception", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modals keep transform-origin center because they are not anchored to a trigger; they appear centered in the viewport."}, {"id": "_agents_skills_emil_design_eng_skill_css_transitions_over_keyframes", "label": "CSS Transitions Over Keyframes", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSS transitions can be interrupted and retargeted mid-animation. Keyframes restart from zero. Use transitions for toasts, toggles, and anything triggered rapidly."}, {"id": "_agents_skills_emil_design_eng_skill_blur_masks_crossfades", "label": "Blur Masks Crossfades", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a crossfade still shows two overlapping objects, a blur of about 2px blends them into one perceived transformation. Keep blur under 20px because heavy blur is expensive, especially in Safari."}, {"id": "_agents_skills_emil_design_eng_skill_starting_style", "label": "@starting-style", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The modern CSS way to animate entry without JavaScript. Fall back to a data-mounted attribute set from useEffect when browser support is missing."}, {"id": "_agents_skills_emil_design_eng_skill_gpu_only_properties", "label": "GPU-Only Properties", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only animate transform and opacity so the work skips layout and paint. Do not drive a child transform by changing a CSS variable on the parent; that recalculates styles for every child."}, {"id": "_agents_skills_emil_design_eng_skill_framer_shorthand_caveat", "label": "Framer Motion Shorthand Caveat", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framer Motion x, y, and scale shorthands are not hardware-accelerated; they run on requestAnimationFrame and drop frames under load. Use a full transform string, or CSS, when the main thread is busy."}, {"id": "_agents_skills_emil_design_eng_skill_waapi", "label": "Web Animations API", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaScript control with CSS performance: hardware-accelerated, interruptible, and no library required."}, {"id": "_agents_skills_emil_design_eng_skill_prefers_reduced_motion", "label": "prefers-reduced-motion", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduced motion means fewer and gentler animations, not zero. Keep opacity and color transitions that aid comprehension, and remove movement and position animations."}, {"id": "_agents_skills_emil_design_eng_skill_hover_gating", "label": "Hover Gating", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gate hover motion behind @media (hover: hover) and (pointer: fine). Touch devices fire hover on tap and cause false positives."}, {"id": "_agents_skills_emil_design_eng_skill_sonner_principles", "label": "Sonner Principles", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loved components win on developer experience, strong defaults, memorable names, invisible edge cases, transitions rather than keyframes, and a documentation site people can touch."}, {"id": "_agents_skills_emil_design_eng_skill_cohesion", "label": "Motion Cohesion", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Match easing and duration to the component's personality. Sonner is slightly slower and uses ease rather than ease-out so the motion matches the toast, the page, and the name."}, {"id": "_agents_skills_emil_design_eng_skill_asymmetric_timing", "label": "Asymmetric Enter/Exit Timing", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slow where the user is deciding and fast where the system responds. Hold-to-delete fills over 2s linear; release snaps back in 200ms ease-out."}, {"id": "_agents_skills_emil_design_eng_skill_stagger", "label": "Stagger", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cascade group entrances with 30-80ms between items. Stagger is decorative and must never block interaction."}, {"id": "_agents_skills_emil_design_eng_skill_momentum_dismissal", "label": "Momentum-Based Dismissal", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not require dragging past a distance threshold. If velocity, distance over elapsed time, exceeds about 0.11, dismiss anyway. A flick should be enough."}, {"id": "_agents_skills_emil_design_eng_skill_boundary_damping", "label": "Boundary Damping", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past a natural edge the element should move less the further it is dragged. Real things slow down before they stop; friction is better than an invisible wall."}, {"id": "_agents_skills_emil_design_eng_skill_hold_to_delete", "label": "Hold to Delete", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A clip-path inset overlay fills over 2s linear while pressed and snaps back in 200ms ease-out on release, with scale 0.97 press feedback."}, {"id": "_agents_skills_emil_design_eng_skill_clip_path_animation", "label": "clip-path Animation", "file_type": "rationale", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "clip-path inset is an animation tool: scroll reveals, hold-to-delete overlays, seamless tab color wipes, and comparison sliders."}, {"id": "_agents_skills_emil_design_eng_skill_translate_percentages", "label": "Percentage Translate", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "translate percentages are relative to the element itself. translateY(100%) moves by the element's own height, which is how Sonner and Vaul position toasts and drawers."}, {"id": "_agents_skills_emil_design_eng_skill_sonner", "label": "Sonner", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toast library whose defaults, naming, and cohesion are the worked example for these component principles."}, {"id": "_agents_skills_emil_design_eng_skill_raycast", "label": "Raycast", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as the correct case of no open/close animation, because the command palette is used hundreds of times a day."}, {"id": "_agents_skills_emil_design_eng_skill_radix_ui", "label": "Radix UI", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides --radix-popover-content-transform-origin so popovers scale from their trigger."}, {"id": "_agents_skills_emil_design_eng_skill_base_ui", "label": "Base UI", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides --transform-origin so popovers scale from their trigger."}, {"id": "_agents_skills_emil_design_eng_skill_vaul", "label": "Vaul", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drawer library cited for translateY(100%) hiding and for gesture interaction."}, {"id": "_agents_skills_emil_design_eng_skill_ionic_framework", "label": "Ionic Framework", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source of the iOS-like drawer curve cubic-bezier(0.32, 0.72, 0, 1)."}, {"id": "_agents_skills_emil_design_eng_skill_easing_dev", "label": "easing.dev", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended source for strong custom easings instead of hand-rolling curves."}, {"id": "_agents_skills_emil_design_eng_skill_easings_co", "label": "easings.co", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended source for strong custom easings instead of hand-rolling curves."}, {"id": "_agents_skills_emil_design_eng_skill_framer_motion", "label": "Framer Motion", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion, formerly Framer Motion. useSpring interpolates decorative mouse tracking; x/y/scale shorthands are not hardware-accelerated."}, {"id": "_agents_skills_emil_design_eng_skill_dynamic_island", "label": "Dynamic Island", "file_type": "concept", "source_file": ".agents/skills/emil-design-eng/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as the kind of element that should feel alive and therefore use a spring."}], "edges": [{"source": "_agents_skills_emil_design_eng_skill_design_engineering", "target": "_age