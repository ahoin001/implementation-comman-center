{"nodes": [{"id": "_agents_skills_review_animations_skill_reviewing_animations", "label": "Reviewing Animations", "file_type": "document", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_review_animations_skill_default_to_flagging", "label": "Default to Flagging", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transition that merely runs but feels sluggish, lands from the wrong origin, fires too often, or drops frames is a regression. Approval is earned, not assumed."}, {"id": "_agents_skills_review_animations_skill_ten_standards", "label": "Ten Non-Negotiable Standards", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every animation in a diff is measured against justified motion, frequency, easing, sub-300ms duration, origin and physicality, interruptibility, GPU-only properties, accessibility, asymmetric timing, and cohesion. A violation is a finding."}, {"id": "_agents_skills_review_animations_skill_justified_motion", "label": "Justified Motion", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every animation must answer why it exists. Looking cool on a frequently seen element is a block."}, {"id": "_agents_skills_review_animations_skill_frequency_appropriate", "label": "Frequency-Appropriate Motion", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyboard-initiated and 100-times-a-day actions get no animation. Tens per day are reduced. Occasional motion is standard. Rare moments may add delight."}, {"id": "_agents_skills_review_animations_skill_responsive_easing", "label": "Responsive Easing", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entering and exiting elements use ease-out or a strong custom cubic-bezier. ease-in on UI is a block because it delays the moment the user watches most."}, {"id": "_agents_skills_review_animations_skill_sub_300ms_ui", "label": "Sub-300ms UI", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI animations stay under 300ms. Anything slower on a UI element needs justification. Per-element budgets live in the standards reference."}, {"id": "_agents_skills_review_animations_skill_origin_physical_correctness", "label": "Origin and Physical Correctness", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Popovers, dropdowns, and tooltips scale from their trigger. Never animate from scale(0); start from scale 0.9-0.97 plus opacity. Modals stay centered."}, {"id": "_agents_skills_review_animations_skill_interruptibility", "label": "Interruptibility", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rapidly triggered or gesture-driven motion must retarget from the current state via CSS transitions or springs, not keyframes that restart from zero."}, {"id": "_agents_skills_review_animations_skill_gpu_only_properties", "label": "GPU-Only Properties", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Animate transform and opacity only. Layout properties, or Framer Motion x/y/scale shorthands under load, are a performance finding."}, {"id": "_agents_skills_review_animations_skill_accessibility", "label": "Animation Accessibility", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Honor prefers-reduced-motion with gentler motion, not zero: keep opacity and color, drop movement. Gate hover animations behind a fine-pointer hover query."}, {"id": "_agents_skills_review_animations_skill_asymmetric_enter_exit", "label": "Asymmetric Enter/Exit", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate actions animate slower; system responses snap. Symmetric timing on a press-and-release or hold is a finding."}, {"id": "_agents_skills_review_animations_skill_cohesion", "label": "Cohesion", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion matches the component's personality and the rest of the product. When unsure whether motion feels right, the strongest move is often to delete it."}, {"id": "_agents_skills_review_animations_skill_escalation_triggers", "label": "Aggressive Escalation Triggers", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flag on sight: transition all, scale(0), ease-in, keyboard animation, UI over 300ms, centered origin on a trigger-anchored popover, keyframes on rapid UI, layout properties, Framer shorthands under load, parent CSS variables driving child transforms, missing reduced-motion, ungated hover, symmetric press timing, and everything-at-once entrances."}, {"id": "_agents_skills_review_animations_skill_remedial_hierarchy", "label": "Remedial Preference Hierarchy", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer earlier fixes: delete the animation, reduce it, fix easing, fix origin, make it interruptible, move it to the GPU, make timing asymmetric, then polish, then accessibility and cohesion."}, {"id": "_agents_skills_review_animations_skill_findings_table", "label": "Findings Table", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required review output is one markdown table with Before, After, and Why. One row per issue. Never a Before/After list."}, {"id": "_agents_skills_review_animations_skill_verdict_tiers", "label": "Verdict Tiers", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group remaining commentary by impact: feel-breaking regressions, missed simplifications, performance, interruptibility and timing, origin and cohesion, then accessibility."}, {"id": "_agents_skills_review_animations_skill_block_decision", "label": "Block Decision", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Block on any feel-breaking regression, animation on a keyboard or high-frequency action, scale(0) or ease-in on UI, or a non-GPU animation with an easy GPU fix."}, {"id": "_agents_skills_review_animations_skill_approve_decision", "label": "Approve Decision", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approve only when there is no feel-breaking regression, no obvious motion that should be deleted, durations and easing are in bounds, interruptibility is handled where needed, and reduced motion is respected."}, {"id": "_agents_skills_review_animations_skill_predetermined_vs_gesture", "label": "Predetermined vs Gesture Motion", "file_type": "rationale", "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer CSS transitions, @starting-style, or WAAPI for predetermined motion. Use JS and springs for dynamic, interruptible, gesture-driven motion."}], "edges": [{"source": "_agents_skills_review_animations_skill_reviewing_animations", "target": "_agents_skills_review_animations_skill_default_to_flagging", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_review_animations_skill_reviewing_animations", "target": "_agents_skills_review_animations_skill_ten_standards", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/review-animations/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_review_animations_sk